# Copy this file to .env.local by running:
# npm run setup
#
# Keep real deployment values in .env.local only. That file is ignored by git.

# Optional override. The application defaults to the password agreed for this private deployment.
ACCESS_PASSWORD=

# Use sftp to read an ignored VS Code SFTP config, or ssh for release/current deploys.
DEPLOY_TRANSPORT=sftp
DEPLOY_SFTP_CONFIG=.vscode/sftp.json

# SSH mode only. Either use a configured SSH host alias:
DEPLOY_SSH_TARGET=

# Or set host/user directly:
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22

# Remote application root for SSH mode. SFTP mode uses remotePath from DEPLOY_SFTP_CONFIG.
DEPLOY_PATH=/path/to/app

# Public base path used when building SvelteKit. Use / for a root deployment.
DEPLOY_BASE_PATH=/your-base-path

# Optional SSH identity file, for example: C:\Users\you\.ssh\id_ed25519
DEPLOY_SSH_KEY=

# Optional SSH-mode commands. They run from the uploaded release/current directory.
DEPLOY_INSTALL_COMMAND=
DEPLOY_RESTART_COMMAND=

# SFTP mode should usually install dependencies on the remote Linux host instead.
# Set true/auto only when you intentionally want to upload local production node_modules.
DEPLOY_UPLOAD_NODE_MODULES=false
DEPLOY_CLEAN_NODE_MODULES=false

# Keep false unless your host explicitly supports Passenger directives in .htaccess.
DEPLOY_WRITE_HTACCESS=false

# Optional local-only URL to check after upload.
DEPLOY_HEALTH_URL=

# Public origin seen by browsers when the app runs behind a proxy.
# If empty, deploy scripts infer it from DEPLOY_HEALTH_URL when possible.
DEPLOY_PUBLIC_ORIGIN=

# Node runtime body limit in bytes. Default in scripts is 10 MiB.
DEPLOY_BODY_SIZE_LIMIT=10485760

# SSH runtime fallback used by npm run remote:start/restart/status.
DEPLOY_REMOTE_NODE=/opt/plesk/node/22/bin/node
DEPLOY_REMOTE_NPM=/opt/plesk/node/22/bin/npm
DEPLOY_REMOTE_PORT=3017
